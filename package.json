{
  "name": "inknote",
  "version": "0.1.0",
  "description": "A local-first Markdown note-taking desktop app for focused writing.",
  "keywords": [
    "electron",
    "notes",
    "markdown",
    "keyboard-first",
    "note-taking",
    "editor",
    "productivity",
    "react",
    "typescript",
    "vite"
  ],
  "homepage": "https://github.com/craftxdog/InkNote#readme",
  "bugs": {
    "url": "https://github.com/craftxdog/InkNote/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craftxdog/InkNote.git"
  },
  "license": "MIT",
  "author": {
    "name": "craftxdog",
    "email": "craftxdog@alphaby.cloud",
    "url": "https://github.com/craftxdog"
  },
  "main": "./release/app/dist/main/main.js",
  "scripts": {
    "build": "npm run verify:release-manifest && electron-vite build",
    "postinstall": "npm --prefix .erb/tooling ci && install-electron && electron-builder install-app-deps",
    "lint": "cross-env NODE_ENV=development eslint . --ext .js,.jsx,.ts,.tsx,.cjs",
    "lint:fix": "cross-env NODE_ENV=development eslint . --ext .js,.jsx,.ts,.tsx,.cjs --fix",
    "package": "npm run build && electron-builder build --publish never",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "release": "npm run build && electron-builder build --publish always",
    "start": "electron-vite dev --watch",
    "test": "cross-env NODE_OPTIONS=--localstorage-file=/tmp/inknote-jest-localstorage jest",
    "test:ci": "cross-env NODE_OPTIONS=--localstorage-file=/tmp/inknote-jest-localstorage jest --runInBand",
    "test:coverage": "cross-env NODE_OPTIONS=--localstorage-file=/tmp/inknote-jest-localstorage jest --coverage --runInBand",
    "test:smoke": "node .erb/scripts/smoke-test.cjs",
    "typecheck": "tsc --noEmit",
    "verify:release-manifest": "node scripts/verify-release-manifest.cjs",
    "verify": "npm run lint && npm run typecheck && npm run test:ci && npm run verify:native-sqlite && npm run build",
    "preview": "electron-vite preview",
    "verify:native-sqlite": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/verify-native-sqlite.cjs"
  },
  "browserslist": [
    "extends browserslist-config-erb"
  ],
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ]
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electron/notarize": "^3.1.1",
    "@inkdropapp/css": "^0.10.4",
    "@lezer/markdown": "^1.8.1",
    "better-sqlite3": "^13.0.3",
    "electron-debug": "^4.1.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "katex": "^0.19.1",
    "pele": "^1.9.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^5.2.0",
    "browserslist-config-erb": "^0.0.3",
    "cross-env": "^10.1.0",
    "electron": "^44.4.0",
    "electron-builder": "^26.5.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.3.0",
    "sass": "^1.104.1",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "type-fest": "^5.9.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-plugin-svgr": "^4.5.0"
  },
  "build": {
    "productName": "InkNote",
    "appId": "com.craftxdog.inknote",
    "asar": true,
    "afterSign": ".erb/scripts/notarize.js",
    "asarUnpack": "**\\*.{node,dll}",
    "files": [
      "dist",
      "node_modules",
      "package.json"
    ],
    "mac": {
      "notarize": false,
      "target": {
        "target": "default",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "category": "public.app-category.productivity",
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "craftxdog",
      "repo": "InkNote"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.0.0",
      "onFail": "error"
    }
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "type": "commonjs"
}
